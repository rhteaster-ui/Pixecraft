{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "server",
    "api",
    "server.ts",
    "vite.config.ts",
    "tests/*.ts"
  ]
}